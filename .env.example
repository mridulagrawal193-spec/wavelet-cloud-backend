# Wavelet Cloud Server Environment Configuration
PORT=4000
NODE_ENV=development

# Storage Mode: 'local' or 's3' (Supports Cloudflare R2, AWS S3, Supabase, MinIO)
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./uploads

# S3 / Cloudflare R2 Credentials (if STORAGE_MODE=s3)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=wavelet-music-stream
S3_PUBLIC_CDN_URL=https://music.yourdomain.com

# Owner Dashboard Secret Key for accessing real-time metrics
OWNER_API_SECRET=wavelet_master_owner_key_2026

# External API Integrations (Optional)
LYRICFIND_API_KEY=
LRCLIB_API_URL=https://lrclib.net/api
